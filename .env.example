# PostgreSQL connection string (Supabase / Neon)
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/db_peminjaman_alat?schema=public"

# Secret untuk menandatangani JWT session (buat string acak panjang)
AUTH_SECRET="ganti-dengan-string-acak-panjang"
